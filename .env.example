# ============================================================================
# ARIS Academy — Environment Configuration
# Copy this file to .env and fill in production values
# VM-ACADEMY: 10.202.101.144 | VM-BBB: 10.202.101.145
# ============================================================================

# --- General ---
NODE_ENV=production

# --- PostgreSQL ---
POSTGRES_USER=academy
POSTGRES_PASSWORD=CHANGE_ME               # openssl rand -base64 32
POSTGRES_DB=academy
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- JWT ---
JWT_SECRET=CHANGE_ME                      # openssl rand -base64 64

# --- MinIO Object Storage ---
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=academy_minio
MINIO_SECRET_KEY=CHANGE_ME                # openssl rand -base64 32

# --- BigBlueButton (VM-BBB: 10.202.101.145) ---
BBB_URL=http://10.202.101.145/bigbluebutton/
BBB_SECRET=CHANGE_ME                      # cat /etc/bigbluebutton/bbb-web-config on VM-BBB

# --- Application URLs ---
APP_URL=https://learning.au-ibar.org
NEXT_PUBLIC_API_URL=https://learning.au-ibar.org/api
NEXT_PUBLIC_APP_URL=https://learning.au-ibar.org

# --- ARIS Core SSO ---
ARIS_SSO_URL=https://au-ibar.org/api/auth
ARIS_SSO_CLIENT_ID=academy-client
ARIS_SSO_CLIENT_SECRET=CHANGE_ME          # Provided by ARIS Core

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME          # openssl rand -base64 16

# --- SMTP (Alertmanager notifications) ---
SMTP_HOST=mail.au-ibar.org
SMTP_PORT=587
SMTP_USER=lms-alerts@au-ibar.org
SMTP_PASSWORD=CHANGE_ME                   # SMTP password for alert emails

# --- Service Ports (internal) ---
SERVICE_PORT_COURSE=4001
SERVICE_PORT_LEARNING=4002
SERVICE_PORT_ASSESSMENT=4003
SERVICE_PORT_LIVE=4004
